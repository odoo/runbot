<odoo>
    <record id="runbot_merge_form_project" model="ir.ui.view">
        <field name="name">Project Form</field>
        <field name="model">runbot_merge.project</field>
        <field name="arch" type="xml">
            <form>
                <field name="freeze_id" invisible="1"/>
                <field name="warn_mergiraf" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not warn_mergiraf">
                    Mergiraf is enabled but not available.
                    You should install it on the server.
                </div>
                <header>
                    <button type="object" name="action_prepare_freeze"
                            string="Freeze"
                            invisible="freeze_id"/>
                    <button type="object" name="action_prepare_freeze"
                            string="View Freeze" class="oe_highlight"
                            invisible="not freeze_id"/>
                    <button type="object" name="action_create_app"
                            invisible="method == 'app'"
                            string="Create Github App"/>
                    <button type="object" name="action_connectors"
                            string="Manage Github Connectors"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name"/></h1>
                    </div>
                    <group col="8">
                        <group colspan="2">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group colspan="2">
                            <field name="staging_enabled" widget="boolean_toggle"/>
                        </group>
                        <group colspan="2">
                            <field name="github_prefix" string="bot name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <group>
                                <group>
                                    <field string="name" name="github_name" readonly="0"
                                           help="Identity when creating new commits, defaults to github name, falls back to login."/>
                                    <field string="name" name="fp_github_name" readonly="0"/>
                                </group>
                                <group>
                                    <field name="github_email" readonly="0"
                                           help="Identity when creating new commits, defaults to public email, falls back to primary email."/>
                                    <field string="Reminder to show after freeze" name="freeze_reminder"/>
                                </group>
                            </group>
                            <separator string="GitHub Auth"/>
                            <group>
                                <group><field name="github_id"/></group>
                                <group><field name="method"/></group>
                            </group>
                            <group invisible="method != 'pat'">
                                <group><field name="main_pat"/></group>
                                <group><field name="fp_pat"/></group>
                            </group>
                            <group invisible="method != 'app'">
                                <group>
                                    <field name="client_id"/>
                                    <field name="client_secret"/>
                                    <field name="webhook_secret"/>
                                </group>
                                <group>
                                    <field name="auth_token"/>
                                    <field name="refresh_token"/>
                                    <field name="auth_expires_at"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tunables" autofocus="autofocus">
                            <group>
                                <group>
                                    <field name="staging_statuses" string="Validate via GH statuses" widget="boolean_toggle"/>
                                    <field name="ci_timeout"/>
                                    <field name="staging_priority"/>
                                    <field name="batch_limit"/>
                                </group>
                                <group>
                                    <field name="fw_nice" widget="boolean_toggle"/>
                                    <field name="use_mergiraf" widget="boolean_toggle"/>
                                    <field name="lateness_limit"/>
                                    <field name="uniquifier" widget="boolean_toggle"/>
                                    <field name="request_missing_statuses" widget="boolean_toggle"/>
                                    <field name="staging_pattern"/>
                                    <field name="staging_sub_pattern"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                    <separator string="Repositories"/>
                    <field name="repo_ids">
                        <tree>
                            <field name="sequence" widget="handle"/>
                            <button type="object" name="get_formview_action" icon="fa-external-link" title="open repo"/>
                            <field name="name"/>
                            <field name="branch_filter"/>
                            <field name="status_ids" widget="many2many_tags"/>
                            <field string="FP remote" name="fp_remote_target"
                                   help="Repository where forward port branches will be created"
                            />
                        </tree>
                    </field>
                    <separator string="Branches"/>
                    <field name="branch_ids">
                        <tree editable="bottom" decoration-muted="not active">
                            <field name="sequence" widget="handle" />
                            <button type="object" name="get_formview_action" icon="fa-external-link" title="open branch"/>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle" options="{'autosave': false}"/>
                            <field name="staging_enabled" widget="boolean_toggle" options="{'autosave': false}"/>
                            <field name="depth_first_splits" widget="boolean_toggle" options="{'autosave': false}"/>
                            <field name="presplit" widget="boolean_toggle" options="{'autosave': false}"/>
                            <field name="optimistic_staging_threshold"/>
                            <field name="on_fail"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_freeze_reminder" model="ir.ui.view">
        <field name="name">Project Form</field>
        <field name="model">runbot_merge.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="freeze_reminder" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="form_create_app" model="ir.ui.view">
        <field name="name">Create App Dialog</field>
        <field name="model">runbot_merge.github_connector.appwizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="project_id"/>
                    <form action="https://github.com" method="POST" target="_blank">
                        <input type="submit" value="Send!"/>
                    </form>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view-list-connector" model="ir.ui.view">
        <field name="name">Github Connector List</field>
        <field name="model">runbot_merge.github_connector</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button name="action_create_app" type="object" string="Create Github App"/>
                </header>
                <field name="name"/>
                <field name="method"/>
            </tree>
        </field>
    </record>

    <record id="view-form-connector" model="ir.ui.view">
        <field name="name">Github Connector Form</field>
        <field name="model">runbot_merge.github_connector</field>
       <field name="arch" type="xml">
           <form>
               <header>
                    <button type="object" name="action_authorize_app"
                            invisible="method == 'pat' or auth_token"
                            string="Authorize Github App"/>
               </header>
               <sheet>
                   <group>
                       <group>
                           <field name="name"/>
                           <field name="method"/>
                       </group>
                       <group invisible="method != 'pat'">
                           <field name="main_pat"/>
                           <field name="fp_pat"/>
                       </group>
                       <group invisible="method != 'app'">
                           <field name="app_url" widget="url"/>
                           <field name="app_id" options="{'enable_formatting': false}"/>
                           <field name="client_id"/>
                           <field name="client_secret"/>
                           <field name="webhook_secret"/>
                           <field name="auth_token"/>
                           <field name="auth_expires_at"/>
                           <field name="refresh_token"/>
                       </group>
                   </group>
                   <group invisible="method != 'app'" string="Private Key">
                       <field name="private_key" nolabel="1" colspan="2"/>
                   </group>
                   <group invisible="method != 'app'" string="Installations">
                       <field name="installations" nolabel="1" colspan="2">
                           <tree>
                               <field name="installation_id" options="{'enable_formatting': false}"/>
                               <field name="owner_login"/>
                               <field name="owner_id" options="{'enable_formatting': false}"/>
                               <field name="repository_selection"/>
                               <field name="repositories"/>
                           </tree>
                       </field>
                   </group>
               </sheet>
           </form>
       </field>
    </record>
</odoo>
