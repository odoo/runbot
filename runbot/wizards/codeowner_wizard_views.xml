<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record model="ir.ui.view" id="runbot_codeowner_wizard_form">
      <field name="name">runbot_codeowner_wizard_form</field>
      <field name="model">runbot.codeowner.wizard</field>
      <field name="arch" type="xml">
        <form string="Codeowner Test">
          <group>
            <field name="file_names" placeholder="odoo/addons/module/file.py&#10;odoo/addons/module/file.js"/>
            <field name="project_id"/>
            <field name="version_id"/>
            <field name="repo_id"/>
          </group>
          <footer>
            <button name="action_test" string="Test" type="object" class="btn-primary"/>
            <button string="Exit" special="cancel" class="btn-default"/>
          </footer>
          <group>
            <field name="result_ids" widget="one2many" options="{'not_delete': True, 'no_create': True}" readonly="1">
              <list>
                <field name="filename"/>
                <field name="reviewers"/>
                <field name="reasons"/>
              </list>
            </field>
          </group>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="runbot_codeowner_wizard_action">
      <field name="name">CodeOwner Test</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">runbot.codeowner.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="runbot_codeowner_wizard_form"/>
      <field name="target">new</field>
    </record>
  </data>
</odoo>
