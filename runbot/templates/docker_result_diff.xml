<odoo>
  <template id="runbot.docker_result_identifier">
    <t t-set="dockerfile" t-value="result.dockerfile_id"/>
    <span class="text-muted" t-esc="dockerfile.image_tag"/>
    <a t-attf-href="/runbot/dockerfile_result/{{result.id}}" t-esc="result.identifier"/>
    <span t-if="result.identifier == dockerfile.image_identifier" class="badge text-bg-success">current</span>
    <span t-elif="dockerfile.has_future and result.identifier == dockerfile.image_future_identifier" class="badge text-bg-info">future</span>
  </template>

  <template id="runbot.docker_result_diff_template">
    <t t-call="runbot.layout">
      <div class="container-fluid">
        <data-table data-group="true">
          <table class="table table-layout-fixed caption-top">
            <caption>
              <h4 class="text-body">
                Metadata diff
                <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="table-group-collapse"/>
              </h4>
            </caption>
            <t t-foreach="diffs" t-as="result_diff">
              <t t-set="result_a" t-value="result_diff[0]"/>
              <t t-set="result_b" t-value="result_diff[1]"/>
              <t t-set="diff" t-value="result_diff[2]"/>
              <!-- only the most recent diff is open by default -->
              <tbody t-attf-class="table-group-divider {{'' if result_diff_first else 'table-group-hidden'}}">
                <tr>
                  <th>
                    <h5 class="fs-6 d-inline">
                      <t t-call="runbot.docker_result_identifier"><t t-set="result" t-value="result_a"/></t>
                      →
                      <t t-call="runbot.docker_result_identifier"><t t-set="result" t-value="result_b"/></t>
                      <small class="text-muted ms-2"><t t-esc="result_a.create_date.strftime('%Y-%m-%d %H:%M')"/> → <t t-esc="result_b.create_date.strftime('%Y-%m-%d %H:%M')"/></small>
                    </h5>
                  </th>
                </tr>
                <tr t-if="not diff">
                  <td><div class="alert alert-success mb-0">No difference</div></td>
                </tr>
                <tr t-foreach="diff" t-as="key">
                  <td>
                    <h6 t-esc="key"/>
                    <pre class="mb-0"><div t-foreach="diff[key]" t-as="line" t-att-class="'text-danger' if line.startswith('- ') else 'text-success' if line.startswith('+ ') else None" t-esc="line"/></pre>
                  </td>
                </tr>
              </tbody>
            </t>
          </table>
        </data-table>
      </div>
    </t>
  </template>
</odoo>
