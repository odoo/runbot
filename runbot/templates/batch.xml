<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="runbot.batch">
            <t t-set="more" t-value="str2bool(request.httprequest.cookies.get('more', ''), False)"/>
            <t t-call="runbot.layout">
                <t t-set="active_category_id" t-value="batch.category_id.id"/>
                <t t-set="page_nav">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a t-attf-href="{{batch.bundle_id._url()}}?category={{active_category_id}}" class="btn btn-link" t-out="batch.bundle_id.name"/>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <a t-att-href="batch._url()" class="btn btn-link">batch-<t t-out="batch.id"/></a>
                        </li>
                    </ol>
                    <span class="ms-auto">
                        <t t-call="runbot.slots_infos"/>
                    </span>
                </t>
                <div class="container-fluid">
                    <div class="row">
                        <t t-set="color" t-value="batch._get_color_class()"/>
                        <t t-set="auto_slots" t-value="batch.slot_ids.filtered(lambda s: not s.trigger_id.manual)"/>
                        <t t-set="manual_slots" t-value="batch.slot_ids.filtered(lambda s: s.trigger_id.manual and (s.build_id or (user_id._is_internal() and ((not s.trigger_id.team_ids) or (user_id in s.trigger_id.team_ids.user_ids)))))"/>
                        <t t-set="old_slots" t-value="more and batch.with_context(active_test=False).slot_ids.filtered(lambda s: not s.active)"/>
                        <t t-set="has_checks" t-value="auto_slots or manual_slots or old_slots"/>
                        <!-- in the header of the checks card if any, else of the batch card -->
                        <t t-set="batch_toolbar">
                            <a groups="runbot.group_runbot_advanced_user" t-attf-href="/odoo/batch/{{batch.id}}"
                               class="btn btn-default btn-ssm" target="_blank" title="View Batch in Backend">
                                <i class="fa fa-list"/>
                            </a>
                        </t>
                        <div class="card-group">
                            <div t-attf-class="card border-{{color}} batch_details">
                                <header class="card-header d-flex align-items-center gap-2">
                                    <span class="h6 mb-1 me-auto">
                                        <i t-if="batch.state in ('preparing', 'ready')" t-attf-class="fa fa-hourglass-half fa-fw text-{{color}} me-1"/>
                                        <i t-else="" t-attf-class="fa fa-{{batch._fa_result()}} fa-fw text-{{color}} me-1"/>
                                        batch-<t t-out="batch.id"/>
                                        <small class="text-body-secondary ms-1" t-att-title="dt2str(batch.create_date)" t-out="batch._get_formated_age()"/>
                                    </span>
                                    <t t-if="not has_checks" t-out="batch_toolbar"/>
                                </header>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <dl>
                                            <t t-if="batch.priority_level">
                                                <dt>Priority</dt>
                                                <dd>
                                                    <t t-if="batch.priority_level &lt; int(batch.create_date.timestamp())">
                                                        <span class="badge text-bg-success">High</span>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-if="batch.priority_level &gt; int(batch.create_date.timestamp())">
                                                            <span class="badge text-bg-secondary">Low</span>
                                                        </t>
                                                        <t t-else="">
                                                            Normal
                                                        </t>
                                                        <a groups="runbot.group_user" role="button" class="btn btn-ssm btn-info" t-attf-href="/runbot/batch/{{batch.id}}/prioritize">Set to high</a>
                                                    </t>
                                                </dd>
                                            </t>
                                            <dt>Category</dt>
                                            <dd t-out="batch.category_id.name"/>
                                            <dt>Version</dt>
                                            <dd t-out="batch.slot_ids[0].params_id.version_id.name if batch.slot_ids else batch.bundle_id.version_id.name"/>
                                            <dt>Create date</dt>
                                            <dd t-out="dt2str(batch.create_date)"/>
                                            <t t-if="more">
                                                <dt>Last update</dt>
                                                <dd>
                                                    <t t-if="batch.last_update" t-out="dt2str(batch.last_update)"/>
                                                    <span class="badge text-bg-info" t-out="s2human(batch.last_update - batch.create_date)"/>
                                                </dd>
                                                <t t-set="load_time" t-value="sum(build.load_time for build in batch.slot_ids.filtered(lambda s: s.link_type != 'rebuild').build_id)"/>
                                                <dt title="With the matched builds">Estimated total load time</dt>
                                                <dd t-att-title="'%ss' % load_time" t-out="precise_s2human(load_time)"/>
                                                <t t-set="real_load_time" t-value="sum(build.real_load_time for build in batch.slot_ids.filtered(lambda s: s.link_type != 'matched').build_id)"/>
                                                <dt>Real load time</dt>
                                                <dd t-att-title="'%ss' % real_load_time" t-out="precise_s2human(real_load_time)"/>
                                            </t>
                                        </dl>
                                    </li>
                                    <!-- Commits -->
                                    <t t-set="commit_links" t-value="batch.commit_link_ids.sorted(key=lambda lc: (lc.commit_id.repo_id.sequence, lc.commit_id.repo_id.id))"/>
                                    <t t-if="commit_links">
                                        <li class="list-group-item fw-bold">Commits</li>
                                        <t t-foreach="commit_links" t-as="commit_link">
                                            <t t-call="runbot.commit_link_item">
                                                <t t-set="hide_stats" t-value="batch.state == 'preparing'"/>
                                            </t>
                                        </t>
                                    </t>
                                    <!-- Reference batches -->
                                    <li t-if="more" class="list-group-item">
                                        <t t-set="reference_batch_ids" t-value="batch.reference_batch_ids"/>
                                        <dl>
                                            <dt>
                                                Reference batches
                                                <t t-if="batch.bundle_id.is_base">(is base)</t>
                                                <t t-elif="reference_batch_ids">(custom, not using base)</t>
                                                <t t-else="">
                                                    <t t-set="reference_batch_ids" t-value="batch.base_reference_batch_id.reference_batch_ids"/>
                                                    (from base)
                                                </t>
                                            </dt>
                                            <dd>
                                                <div t-foreach="reference_batch_ids.sorted(lambda b: b.bundle_id.version_id.number, reverse=True)" t-as="reference_batch" t-attf-title="Created {{s2human(reference_batch.create_date - batch.create_date)}} before this one">
                                                    <a t-attf-href="/runbot/batch/{{reference_batch.id}}"><t t-out="reference_batch.bundle_id.version_id.name"/> (<t t-out="reference_batch.id"/>)</a>
                                                </div>
                                            </dd>
                                        </dl>
                                    </li>
                                </ul>
                            </div>
                            <div t-if="has_checks" t-attf-class="card border-{{color}} batch_builds">
                                <header class="card-header d-flex align-items-center gap-2 justify-content-end">
                                    <t t-out="batch_toolbar"/>
                                </header>
                                <div class="card-body">
                                    <t t-foreach="[('Builds', auto_slots, ''), ('Manual', manual_slots, ''), ('Old builds', old_slots, 'line-through')]" t-as="group">
                                        <t t-if="group[1]">
                                            <div class="slots_title fw-bold text-body-secondary" t-out="group[0]"/>
                                            <div t-foreach="group[1]" t-as="slot" t-att-class="group[2] or None">
                                                <t t-call="runbot.slot_button"/>
                                            </div>
                                        </t>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div t-if="batch.log_ids" class="row">
                        <div class="col-md-12">
                            <div class="card mt-2">
                                <header class="card-header">Logs</header>
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="batch.log_ids" t-as="log">
                                        <t t-set="logclass" t-value="dict(ERROR='danger', WARNING='warning', INFO='info').get(log.level, 'warning')"/>
                                        <li t-attf-class="list-group-item list-group-item-{{logclass}}">
                                            <b t-out="log.level"/>
                                            --
                                            <t t-out="log._markdown()"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="runbot.trigger_report">
            <t t-call="runbot.layout">
                <t t-call="{{trigger.report_view_id.id}}">
                </t>
            </t>
        </template>
    </data>
</odoo>
