<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="runbot.build_error_cards">
      <table class="table table-group table-layout-fixed caption-top text-body-tertiary">
        <caption>
          <div class="row">
            <h2 class="col-12 col-md-auto">
              <t t-out="table_title"/>
              <span t-if="build_errors_counter" class="badge text-bg-primary fs-6 align-middle" t-out="build_errors_counter"/>
              <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="table-group-collapse"/>
            </h2>
            <div class="btn-toolbar col-12 col-md-auto ms-auto gap-2">
              <t t-out="additional_buttons"/>
            </div>
          </div>
        </caption>
        <colgroup>
          <col/>
          <col class="w-50"/>
          <col class="w-25"/>
          <col/>
          <col/>
        </colgroup>
        <thead>
          <tr>
            <th>Last seen</th>
            <th>Summary</th>
            <th>Triggers</th>
            <th>Assigned to</th>
            <th/>
          </tr>
        </thead>
        <t t-foreach="build_errors" t-as="build_error">
          <tbody class="table-group-divider table-group-hidden">
            <tr>
              <td t-out="build_error.last_seen_date" t-options='{"widget": "datetime"}'/>
              <th>
                <a t-attf-href="/runbot/error/{{build_error.id}}" title="View error details"><code t-out="build_error.name"/></a>
              </th>
              <td>
                <t t-foreach="build_error.trigger_ids" t-as="trigger">
                  <span class="badge text-bg-info" t-out="trigger.name"/>
                </t>
              </td>
              <td>
                <t t-if="build_error.responsible" t-out="build_error.responsible.name"/>
                <a t-else="" t-attf-href="/runbot/errors/assign/{{build_error.id}}" data-runbot="action" role="button" class="btn btn-primary btn-sm">Assign to me</a>
              </td>
              <td class="text-nowrap">
                <a t-att-href="build_error.last_seen_build_id.build_url" t-attf-title="View last affected build ({{build_error.last_seen_build_id.id}})">
                  <i class="fa fa-external-link"/>
                </a>
                <a groups="base.group_user" t-attf-href="/odoo/error/{{build_error.id}}" target="_blank" title="View in Backend">
                  <span class="badge text-bg-info" t-out="build_error.build_count" t-attf-title="This error was seen {{build_error.build_count}} View in backend"/>
                </a>
                <span groups="!base.group_user" class="badge text-bg-info" t-out="build_error.build_count" t-attf-title="This error was seen {{build_error.build_count}}"/>
                <span class="fa fa-random" t-if="build_error.random"/>
              </td>
            </tr>
            <tr>
              <td colspan="5">
                <div class="overflow-x-auto">
                    <pre class="bg-danger-subtle p-2" t-out="build_error.content.strip()"/>
                </div>
              </td>
            </tr>
          </tbody>
        </t>
      </table>
    </template>

    <template id="runbot.build_error">
      <t t-call='runbot.layout'>
        <div class="container-fluid">
          <div class="row">
            <div class='col-md-12'>
              <t t-if="page==1 and current_user_errors">
                <t t-call="runbot.build_error_cards">
                  <t t-set="table_title">Your assigned build errors</t>
                  <t t-set="build_errors" t-value="current_user_errors"/>
                  <t t-set="build_errors_counter" t-value="len(current_user_errors)"/>
                </t>
              </t>
              <t t-if="page==1 and current_team_errors">
                <t t-call="runbot.build_error_cards">
                  <t t-set="table_title">Team unassigned build errors</t>
                  <t t-set="build_errors" t-value="current_team_errors"/>
                  <t t-set="build_errors_counter" t-value="len(current_team_errors)"/>
                </t>
              </t>
              <t t-if="build_errors">
                <t t-call="runbot.build_error_cards">
                  <t t-set="table_title">All builds errors</t>
                  <t t-set="build_errors" t-value="build_errors"/>
                  <t t-set="build_errors_counter" t-value="current_user_errors.search_count([])"/>
                  <t t-set="additional_buttons">
                    <t t-call="runbot.search_dropdown">
                      <t t-set="label">Sort By</t>
                      <t t-set="param" t-valuef="sort"/>
                      <t t-set="options" t-value="sort_order_choices"/>
                      <t t-set="value" t-value="sort_order"/>
                    </t>
                    <t t-call="runbot.pager">
                      <t t-set="classes" t-valuef="pagination-sm"/>
                    </t>
                  </t>
                </t>
              </t>
            </div>
          </div>
        </div>
      </t>
    </template>

    <template id="runbot.build_error_details">
      <t t-call="runbot.layout">
        <t t-set="page_nav">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
              <a href="/runbot/errors" class="btn btn-link">Errors</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
              <a t-attf-href="/runbot/error/{{details['id']}}" class="btn btn-link">error-<t t-out="details['id']"/></a>
            </li>
          </ol>
          <a t-attf-href="/odoo/error/{{details['id']}}"
             class="btn btn-default btn-ssm" target="_blank" title="View in Backend">
            <i class="fa fa-list"/>
          </a>
        </t>
        <div class="container-fluid">
          <div class="row">
            <div class="col-lg-6">
              <table class="table">
                <tr>
                  <td>Name</td>
                  <td><code t-out="details['name']"/></td>
                </tr>
                <tr t-if="'active' in details">
                  <td>Status</td>
                  <td>
                    <span t-if="details['active']" class="badge text-bg-danger">Open</span>
                    <span t-else="" class="badge text-bg-success">Fixed</span>
                    <span t-if="details.get('random')" class="badge text-bg-warning"><i class="fa fa-random"/> Random</span>
                  </td>
                </tr>
                <tr t-if="'responsible' in details">
                  <td>Assigned to</td>
                  <td>
                    <t t-if="details['responsible']" t-out="details['responsible']['display_name']"/>
                    <a t-else="" t-attf-href="/runbot/errors/assign/{{details['id']}}" data-runbot="action" role="button" class="btn btn-primary btn-sm">Assign to me</a>
                  </td>
                </tr>
                <tr t-if="'team_id' in details">
                  <td>Team</td>
                  <td t-out="details['team_id'] and details['team_id']['display_name']"/>
                </tr>
                <tr t-if="'trigger_ids' in details">
                  <td>Triggers</td>
                  <td>
                    <span t-foreach="details['trigger_ids']" t-as="trigger" class="badge text-bg-info" t-out="trigger['display_name']"/>
                  </td>
                </tr>
                <tr t-if="'version_ids' in details">
                  <td>Versions</td>
                  <td>
                    <span t-foreach="details['version_ids']" t-as="version" class="badge text-bg-secondary" t-out="version['display_name']"/>
                  </td>
                </tr>
                <tr t-if="details.get('tag_ids')">
                  <td>Tags</td>
                  <td>
                    <span t-foreach="details['tag_ids']" t-as="tag" class="badge text-bg-secondary" t-out="tag['display_name']"/>
                  </td>
                </tr>
                <tr t-if="details.get('test_tags')">
                  <td>Test tags</td>
                  <td>
                    <code t-out="details['test_tags']"/>
                    <span t-if="details.get('tags_min_version_id')" class="badge text-bg-secondary">from <t t-out="details['tags_min_version_id']['display_name']"/></span>
                    <span t-if="details.get('tags_max_version_id')" class="badge text-bg-secondary">up to <t t-out="details['tags_max_version_id']['display_name']"/></span>
                  </td>
                </tr>
                <tr t-if="details.get('breaking_pr_id')">
                  <td>Breaking PR</td>
                  <td><a t-att-href="details['breaking_pr_url']" target="_blank" t-out="details['breaking_pr_id']['display_name']"/></td>
                </tr>
                <tr t-if="details.get('fixing_pr_id')">
                  <td>Fixing PR</td>
                  <td>
                    <a t-att-href="details['fixing_pr_url']" target="_blank" t-out="details['fixing_pr_id']['display_name']"/>
                    <a t-if="details.get('fixing_bundle_id')" t-att-href="details['fixing_bundle_url']" t-out="details['fixing_bundle_id']['display_name']"/>
                  </td>
                </tr>
                <tr t-if="details.get('fixing_commit')">
                  <td>Fixing commit</td>
                  <td><code t-out="details['fixing_commit']"/></td>
                </tr>
                <tr t-if="details.get('previous_error_id')">
                  <td>Already seen error</td>
                  <td><a t-attf-href="/runbot/error/{{details['previous_error_id']['id']}}">error-<t t-out="details['previous_error_id']['id']"/></a></td>
                </tr>
                <tr t-if="'first_seen_date' in details">
                  <td>First seen</td>
                  <td>
                    <t t-out="details['first_seen_date']" t-options='{"widget": "datetime"}'/>
                    <a t-if="details.get('first_seen_build_id')" t-attf-href="/runbot/build/{{details['first_seen_build_id']['id']}}">build <t t-out="details['first_seen_build_id']['id']"/></a>
                  </td>
                </tr>
                <tr t-if="'last_seen_date' in details">
                  <td>Last seen</td>
                  <td>
                    <t t-out="details['last_seen_date']" t-options='{"widget": "datetime"}'/>
                    <a t-if="details.get('last_seen_build_id')" t-attf-href="/runbot/build/{{details['last_seen_build_id']['id']}}">build <t t-out="details['last_seen_build_id']['id']"/></a>
                  </td>
                </tr>
                <tr t-if="'build_count' in details">
                  <td>Seen</td>
                  <td><a t-attf-href="/runbot/build/search?build_error_id={{details['id']}}"><t t-out="details['build_count']"/> builds</a></td>
                </tr>
              </table>
            </div>
            <div t-if="'last_seen_batch_ids' in details" class="col-lg-6">
              <table class="table">
                <thead>
                  <tr>
                    <th>Version</th>
                    <th>Last seen batch</th>
                    <th>Bundle</th>
                  </tr>
                </thead>
                <tr t-foreach="details['last_seen_batch_ids']" t-as="batch">
                  <td t-out="batch['bundle_id']['version_id'] and batch['bundle_id']['version_id']['display_name']"/>
                  <td><a t-attf-href="/runbot/batch/{{batch['id']}}">batch-<t t-out="batch['id']"/></a></td>
                  <td><a t-attf-href="/runbot/bundle/{{batch['bundle_id']['id']}}" t-out="batch['bundle_id']['display_name']"/></td>
                </tr>
              </table>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12">
              <h3>Contents</h3>
              <div t-foreach="details['error_content_ids']" t-as="error_content" class="mb-3">
                <div class="small text-body-secondary">
                  <code t-out="error_content['module_name']"/>
                  <t t-if="error_content['function']">in <code t-out="error_content['function']"/></t>
                  <t t-if="error_content['file_path']">(<code t-out="error_content['file_path']"/>)</t>
                  <t t-if="'build_count' in error_content">
                    · seen <t t-out="error_content['build_count']"/> times,
                    last <t t-out="error_content['last_seen_date']" t-options='{"widget": "datetime"}'/>
                  </t>
                </div>
                <div class="overflow-x-auto">
                  <pre class="bg-danger-subtle p-2" t-out="error_content['content'].strip()"/>
                </div>
              </div>
            </div>
          </div>
        </div>
      </t>
    </template>

    <template id="runbot.team">
      <t t-call='runbot.layout'>
        <div class="container-fluid">
          <div class="row">
            <div t-if="team" class='col-md-12'>
              <div class="col-lg-12 text-center mb16">
                <h2>Team <t t-out="team.name.capitalize()"/>
                  <a groups="base.group_user"
                    t-attf-href="/odoo/team/{{team.id}}" target="_blank" title="View in Backend">
                    <i class="fa fa-list"/>
                  </a>
                </h2>
              </div>
              <div t-if="team.dashboard_id">
                <h3 t-if="team.dashboard_id.dashboard_tile_ids">Dashboards</h3>
                <t t-call="runbot.dashboard">
                  <t t-set="dashboard" t-value="team.dashboard_id"/>
                </t>
              </div>
              <div class="d-flex">
                <h3 t-if="assignment_ids">Team assigned Errors</h3>
                <div class="d-flex gap-2 ms-2 mb-4">
                  <t t-call="runbot.search_dropdown">
                    <t t-set="label">Sort By</t>
                    <t t-set="param" t-valuef="sortby"/>
                    <t t-set="options" t-value="{key: sorting['label'] for key, sorting in searchbar_sortings.items()}"/>
                    <t t-set="value" t-value="sortby"/>
                  </t>
                  <t t-call="runbot.search_dropdown">
                    <t t-set="label">Filter By</t>
                    <t t-set="param" t-valuef="filterby"/>
                    <t t-set="options" t-value="{key: filter['label'] for key, filter in searchbar_filters.items()}"/>
                    <t t-set="value" t-value="filterby"/>
                  </t>
                </div>
              </div>
              <t t-call="runbot.build_error_cards">
                <t t-set="build_errors" t-value="assignment_ids"/>
                <t t-set="accordion_id">team_errors</t>
              </t>
            </div>
            <!-- Display list of teams of no team is supplied -->
            <div t-if="not team" class='col-md-12'>
              <h3> Teams</h3>
              <div class="row">
                <div class="list-group list-group-horizontal">
                  <t t-foreach="teams" t-as="team">
                    <a t-attf-href="/runbot/teams/{{ team.id }}" class="list-group-item list-group-item-action"><t t-out="team.name"/></a>
                  </t>
                </div>
              </div>
            </div>
          </div>
        </div>
      </t>
    </template>
    <template id="runbot.docker_result_template">
      <t t-call='runbot.layout'>
        <div class="container-fluid">
          <div class="row">
            <div class='col-md-12'>
              <h4><t t-esc="dockerfile.image_tag"/></h4>
              <t t-if="dockerfile_result.identifier not in (dockerfile.image_identifier, dockerfile.image_future_identifier)">
                <div class="alert alert-warning">
                  This version of the docker image is outdated and was modified since, latest version <a t-attf-href="/runbot/dockerfile_result/{{dockerfile.last_successful_result.id}}">here</a>
                </div>
              </t>
              <t t-else="">
                <t t-if="dockerfile.image_identifier == dockerfile.image_future_identifier">
                  <div class="alert alert-success">
                    This is the latest version of the docker image
                  </div>
                </t>
                <t t-else="">
                  <t t-if="dockerfile.image_identifier == dockerfile_result.identifier">
                    <div class="alert alert-info">
                      This is the latest stable version of the docker image, but <a t-attf-href="/runbot/dockerfile_result/{{future_result.id}}">another future version</a> exists
                      <details>
                        <summary>Diff</summary>
                        <t t-out="future_diff"/>
                      </details>
                    </div>
                  </t>
                  <t t-else="">
                    <div class="alert alert-info">
                      This is the future version of the docker image, <a t-attf-href="/runbot/dockerfile_result/{{current_result.id}}">current version here</a>
                    </div>
                  </t>
                </t>
              </t>
            </div>
          </div>
          <div class="row">
            <div class='col-md-12'>
              <b>Identifier</b>: <t t-esc="dockerfile_result.identifier"></t><br/>
              <b>Dockerfile</b>: <a t-attf-href="/runbot/dockerfile/result/{{current_result.id}}">raw</a><br/>
              <b>Metadata</b>: <pre><t t-esc="json.dumps((dockerfile_result.metadata.dict), indent=3)"></t></pre>
            </div>
          </div>
        </div>
      </t>
    </template>
  </data>
</odoo>
