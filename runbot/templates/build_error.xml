<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="runbot.build_error_cards">
      <table class="table table-group table-layout-fixed caption-top text-body-tertiary">
        <caption>
          <div class="row">
            <h2 class="col-12 col-md-auto">
              <t t-out="table_title"/>
              <span t-if="build_errors_counter" class="badge text-bg-primary fs-6 align-middle" t-out="build_errors_counter"/>
              <button type="button" class="btn btn-sm btn-outline-primary" data-toggle="table-group-collapse"/>
            </h2>
            <div class="btn-toolbar col-12 col-md-auto ms-auto gap-2">
              <t t-out="additional_buttons"/>
            </div>
          </div>
        </caption>
        <colgroup>
          <col/>
          <col class="w-50"/>
          <col class="w-25"/>
          <col/>
          <col/>
        </colgroup>
        <thead>
          <tr>
            <th>Last seen</th>
            <th>Summary</th>
            <th>Triggers</th>
            <th>Assigned to</th>
            <th/>
          </tr>
        </thead>
        <t t-foreach="build_errors" t-as="build_error">
          <tbody class="table-group-divider table-group-hidden">
            <tr>
              <td t-out="build_error.last_seen_date" t-options='{"widget": "datetime"}'/>
              <th>
                <code t-out="build_error.name"/>
              </th>
              <td>
                <t t-foreach="build_error.trigger_ids" t-as="trigger">
                  <span class="badge text-bg-info" t-out="trigger.name"/>
                </t>
              </td>
              <td>
                <t t-if="build_error.responsible" t-out="build_error.responsible.name"/>
                <a t-else="" t-attf-href="/runbot/errors/assign/{{build_error.id}}" data-runbot="action" role="button" class="btn btn-primary btn-sm">Assign to me</a>
              </td>
              <td class="text-nowrap">
                <a t-att-href="build_error.last_seen_build_id.build_url" t-attf-title="View last affected build ({{build_error.last_seen_build_id.id}})">
                  <i class="fa fa-external-link"/>
                </a>
                <a groups="base.group_user" t-attf-href="/odoo/error/{{build_error.id}}" target="_blank" title="View in Backend">
                  <span class="badge text-bg-info" t-out="build_error.build_count" t-attf-title="This error was seen {{build_error.build_count}} View in backend"/>
                </a>
                <span groups="!base.group_user" class="badge text-bg-info" t-out="build_error.build_count" t-attf-title="This error was seen {{build_error.build_count}}"/>
                <span class="fa fa-random" t-if="build_error.random"/>
              </td>
            </tr>
            <tr>
              <td colspan="5">
                <div class="overflow-x-auto">
                    <pre class="bg-danger-subtle p-2" t-out="build_error.content.strip()"/>
                </div>
              </td>
            </tr>
          </tbody>
        </t>
      </table>
    </template>

    <template id="runbot.build_error">
      <t t-call='runbot.layout'>
        <div class="container-fluid">
          <div class="row">
            <div class='col-md-12'>
              <t t-if="page==1 and current_user_errors">
                <t t-call="runbot.build_error_cards">
                  <t t-set="table_title">Your assigned build errors</t>
                  <t t-set="build_errors" t-value="current_user_errors"/>
                  <t t-set="build_errors_counter" t-value="len(current_user_errors)"/>
                </t>
              </t>
              <t t-if="page==1 and current_team_errors">
                <t t-call="runbot.build_error_cards">
                  <t t-set="table_title">Team unassigned build errors</t>
                  <t t-set="build_errors" t-value="current_team_errors"/>
                  <t t-set="build_errors_counter" t-value="len(current_team_errors)"/>
                </t>
              </t>
              <t t-if="build_errors">
                <t t-call="runbot.build_error_cards">
                  <t t-set="table_title">All builds errors</t>
                  <t t-set="build_errors" t-value="build_errors"/>
                  <t t-set="build_errors_counter" t-value="current_user_errors.search_count([])"/>
                  <t t-set="additional_buttons">
                    <t t-call="runbot.search_dropdown">
                      <t t-set="label">Sort By</t>
                      <t t-set="param" t-valuef="sort"/>
                      <t t-set="options" t-value="sort_order_choices"/>
                      <t t-set="value" t-value="sort_order"/>
                    </t>
                    <t t-call="runbot.pager">
                      <t t-set="classes" t-valuef="pagination-sm"/>
                    </t>
                  </t>
                </t>
              </t>
            </div>
          </div>
        </div>
      </t>
    </template>

    <template id="runbot.build_error_details">
      <t t-call="runbot.layout">
        <t t-set="page_nav">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
              <a href="/runbot/errors" class="btn btn-link">Errors</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
              <a t-attf-href="/runbot/error/{{build_error.id}}" class="btn btn-link">error-<t t-out="build_error.id"/></a>
            </li>
          </ol>
        </t>
        <div class="container-fluid">
          <div class="row">
            <t t-set="color" t-value="'danger' if build_error.active else 'success'"/>
            <t t-set="header_class" t-value="'text-bg-%s-subtle' % color"/>
            <div class="card-group">
              <div t-attf-class="card border-{{color}}">
                <header t-attf-class="card-header d-flex flex-wrap align-items-center gap-2 {{header_class}}">
                  <span class="h6 mb-1 me-auto">
                    <i t-attf-class="fa fa-{{'exclamation-triangle' if build_error.active else 'check'}} fa-fw me-1"/>
                    error-<t t-out="build_error.id"/>
                    <small class="text-body-secondary ms-1" t-out="'Open' if build_error.active else 'Fixed'"/>
                    <span t-if="build_error.random" class="badge text-bg-warning ms-1"><i class="fa fa-random"/> Random</span>
                  </span>
                  <a t-if="not build_error.responsible" t-attf-href="/runbot/errors/assign/{{build_error.id}}" data-runbot="action" role="button" class="btn btn-primary btn-ssm">Assign to me</a>
                  <a t-attf-href="/odoo/error/{{build_error.id}}" class="btn btn-default btn-ssm" target="_blank" title="View in Backend">
                    <i class="fa fa-list"/>
                  </a>
                </header>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item">
                    <dl>
                      <dt>Name</dt>
                      <dd><code t-out="build_error.name"/></dd>
                      <dt>Assigned to</dt>
                      <dd t-out="build_error.responsible.display_name or 'Nobody'"/>
                      <dt>Team</dt>
                      <dd t-out="build_error.team_id.display_name or 'None'"/>
                      <t t-if="build_error.trigger_ids">
                        <dt>Triggers</dt>
                        <dd>
                          <span t-foreach="build_error.trigger_ids" t-as="trigger" class="badge text-bg-info me-1" t-out="trigger.display_name"/>
                        </dd>
                      </t>
                      <t t-if="build_error.version_ids">
                        <dt>Versions</dt>
                        <dd>
                          <span t-foreach="build_error.version_ids" t-as="version" class="badge text-bg-secondary me-1" t-out="version.display_name"/>
                        </dd>
                      </t>
                      <t t-if="build_error.tag_ids">
                        <dt>Tags</dt>
                        <dd>
                          <span t-foreach="build_error.tag_ids" t-as="tag" class="badge text-bg-secondary me-1" t-out="tag.display_name"/>
                        </dd>
                      </t>
                      <t t-if="build_error.test_tags">
                        <dt>Test tags</dt>
                        <dd>
                          <code class="text-break" t-out="build_error.test_tags"/>
                          <span t-if="build_error.tags_min_version_id" class="badge text-bg-secondary">from <t t-out="build_error.tags_min_version_id.display_name"/></span>
                          <span t-if="build_error.tags_max_version_id" class="badge text-bg-secondary">up to <t t-out="build_error.tags_max_version_id.display_name"/></span>
                        </dd>
                      </t>
                    </dl>
                  </li>
                  <li t-if="build_error.breaking_pr_id or build_error.fixing_pr_id or build_error.fixing_commit or build_error.previous_error_id" class="list-group-item">
                    <dl>
                      <t t-if="build_error.breaking_pr_id">
                        <dt>Breaking PR</dt>
                        <dd><a t-att-href="build_error.breaking_pr_url" target="_blank" t-out="build_error.breaking_pr_id.display_name"/></dd>
                      </t>
                      <t t-if="build_error.fixing_pr_id">
                        <dt>Fixing PR</dt>
                        <dd>
                          <a t-att-href="build_error.fixing_pr_url" target="_blank" t-out="build_error.fixing_pr_id.display_name"/>
                          <a t-if="build_error.fixing_bundle_id" t-att-href="build_error.fixing_bundle_url" t-out="build_error.fixing_bundle_id.display_name"/>
                        </dd>
                      </t>
                      <t t-if="build_error.fixing_commit">
                        <dt>Fixing commit</dt>
                        <dd><code t-out="build_error.fixing_commit"/></dd>
                      </t>
                      <t t-if="build_error.previous_error_id">
                        <dt>Already seen error</dt>
                        <dd><a t-attf-href="/runbot/error/{{build_error.previous_error_id.id}}">error-<t t-out="build_error.previous_error_id.id"/></a></dd>
                      </t>
                    </dl>
                  </li>
                  <li class="list-group-item">
                    <dl>
                      <dt>First seen</dt>
                      <dd>
                        <t t-out="build_error.first_seen_date and dt2str(build_error.first_seen_date)"/>
                        <a t-if="build_error.first_seen_build_id" t-attf-href="/runbot/build/{{build_error.first_seen_build_id.id}}">build <t t-out="build_error.first_seen_build_id.id"/></a>
                      </dd>
                      <dt>Last seen</dt>
                      <dd>
                        <t t-out="build_error.last_seen_date and dt2str(build_error.last_seen_date)"/>
                        <a t-if="build_error.last_seen_build_id" t-attf-href="/runbot/build/{{build_error.last_seen_build_id.id}}">build <t t-out="build_error.last_seen_build_id.id"/></a>
                      </dd>
                      <dt>Seen</dt>
                      <dd><t t-out="build_error.build_count"/> builds</dd>
                    </dl>
                  </li>
                </ul>
              </div>
              <div t-if="build_error.last_seen_batch_ids" t-attf-class="card border-{{color}}">
                <header t-attf-class="card-header {{header_class}}">
                  <span class="h6 mb-1">Last seen batches</span>
                </header>
                <table class="table table-sm mb-0">
                  <tr>
                    <th>Version</th>
                    <th>Batch</th>
                    <th>Bundle</th>
                  </tr>
                  <tr t-foreach="build_error.last_seen_batch_ids" t-as="batch">
                    <td t-out="batch.bundle_id.version_id.display_name"/>
                    <td><a t-attf-href="/runbot/batch/{{batch.id}}">batch-<t t-out="batch.id"/></a></td>
                    <td><a t-attf-href="/runbot/bundle/{{batch.bundle_id.id}}" t-out="batch.bundle_id.display_name"/></td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12">
              <div class="card mt-2 overflow-hidden">
                <header class="card-header">Contents</header>
                <ul class="list-group list-group-flush">
                  <li t-foreach="build_error.error_content_ids" t-as="error_content" class="list-group-item">
                    <div class="small text-body-secondary mb-1">
                      <code t-out="error_content.module_name"/>
                      <t t-if="error_content.function">in <code t-out="error_content.function"/></t>
                      <t t-if="error_content.file_path">(<code t-out="error_content.file_path"/>)</t>
                      · seen <t t-out="error_content.build_count"/> times,
                      last <t t-out="error_content.last_seen_date and dt2str(error_content.last_seen_date)"/>
                    </div>
                    <div class="overflow-x-auto">
                      <pre t-attf-class="bg-{{color}}-subtle p-2 mb-0" t-out="error_content.content.strip()"/>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </t>
    </template>

    <template id="runbot.team">
      <t t-call='runbot.layout'>
        <div class="container-fluid">
          <div class="row">
            <div t-if="team" class='col-md-12'>
              <div class="col-lg-12 text-center mb16">
                <h2>Team <t t-out="team.name.capitalize()"/>
                  <a groups="base.group_user"
                    t-attf-href="/odoo/team/{{team.id}}" target="_blank" title="View in Backend">
                    <i class="fa fa-list"/>
                  </a>
                </h2>
              </div>
              <div t-if="team.dashboard_id">
                <h3 t-if="team.dashboard_id.dashboard_tile_ids">Dashboards</h3>
                <t t-call="runbot.dashboard">
                  <t t-set="dashboard" t-value="team.dashboard_id"/>
                </t>
              </div>
              <div class="d-flex">
                <h3 t-if="assignment_ids">Team assigned Errors</h3>
                <div class="d-flex gap-2 ms-2 mb-4">
                  <t t-call="runbot.search_dropdown">
                    <t t-set="label">Sort By</t>
                    <t t-set="param" t-valuef="sortby"/>
                    <t t-set="options" t-value="{key: sorting['label'] for key, sorting in searchbar_sortings.items()}"/>
                    <t t-set="value" t-value="sortby"/>
                  </t>
                  <t t-call="runbot.search_dropdown">
                    <t t-set="label">Filter By</t>
                    <t t-set="param" t-valuef="filterby"/>
                    <t t-set="options" t-value="{key: filter['label'] for key, filter in searchbar_filters.items()}"/>
                    <t t-set="value" t-value="filterby"/>
                  </t>
                </div>
              </div>
              <t t-call="runbot.build_error_cards">
                <t t-set="build_errors" t-value="assignment_ids"/>
                <t t-set="accordion_id">team_errors</t>
              </t>
            </div>
            <!-- Display list of teams of no team is supplied -->
            <div t-if="not team" class='col-md-12'>
              <h3> Teams</h3>
              <div class="row">
                <div class="list-group list-group-horizontal">
                  <t t-foreach="teams" t-as="team">
                    <a t-attf-href="/runbot/teams/{{ team.id }}" class="list-group-item list-group-item-action"><t t-out="team.name"/></a>
                  </t>
                </div>
              </div>
            </div>
          </div>
        </div>
      </t>
    </template>
    <template id="runbot.docker_result_template">
      <t t-call='runbot.layout'>
        <div class="container-fluid">
          <div class="row">
            <div class='col-md-12'>
              <h4><t t-esc="dockerfile.image_tag"/></h4>
              <t t-if="dockerfile_result.identifier not in (dockerfile.image_identifier, dockerfile.image_future_identifier)">
                <div class="alert alert-warning">
                  This version of the docker image is outdated and was modified since, latest version <a t-attf-href="/runbot/dockerfile_result/{{dockerfile.last_successful_result.id}}">here</a>
                </div>
              </t>
              <t t-else="">
                <t t-if="dockerfile.image_identifier == dockerfile.image_future_identifier">
                  <div class="alert alert-success">
                    This is the latest version of the docker image
                  </div>
                </t>
                <t t-else="">
                  <t t-if="dockerfile.image_identifier == dockerfile_result.identifier">
                    <div class="alert alert-info">
                      This is the latest stable version of the docker image, but <a t-attf-href="/runbot/dockerfile_result/{{future_result.id}}">another future version</a> exists
                      <details>
                        <summary>Diff</summary>
                        <t t-out="future_diff"/>
                      </details>
                    </div>
                  </t>
                  <t t-else="">
                    <div class="alert alert-info">
                      This is the future version of the docker image, <a t-attf-href="/runbot/dockerfile_result/{{current_result.id}}">current version here</a>
                    </div>
                  </t>
                </t>
              </t>
            </div>
          </div>
          <div class="row">
            <div class='col-md-12'>
              <b>Identifier</b>: <t t-esc="dockerfile_result.identifier"></t><br/>
              <b>Dockerfile</b>: <a t-attf-href="/runbot/dockerfile/result/{{current_result.id}}">raw</a><br/>
              <b>Metadata</b>: <pre><t t-esc="json.dumps((dockerfile_result.metadata.dict), indent=3)"></t></pre>
            </div>
          </div>
        </div>
      </t>
    </template>
  </data>
</odoo>
