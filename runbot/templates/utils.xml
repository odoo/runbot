<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- base layout -->
        <template id="runbot.base_page">&lt;!DOCTYPE html&gt;
            <t t-set="theme" t-value="request.httprequest.cookies.get('theme', 'legacy')"/>
            <t t-set="more" t-value="str2bool(request.httprequest.cookies.get('more', ''), False)"/>
            <t t-set="refresh" t-value="request.params.get('refresh')"/>
            <html t-att-data-bs-theme="theme">
                <head>
                    <meta charset="utf-8"/>
                    <title t-out="title or ('Runbot %s' % project.name if project else 'Runbot')"/>

                    <t t-call-assets="runbot.assets_frontend" t-js="False"/>
                    <t t-call-assets="runbot.assets_frontend" t-css="False" defer_load="True"/>
                    <t t-if="'tests' in debug or test_mode_enabled">
                        <t t-call-assets="web.assets_frontend" t-css="False" defer_load="True"/>
                    </t>
                    <t t-call="web.conditional_assets_tests" ignore_missing_deps="True"/>

                    <t t-if="refresh">
                        <meta http-equiv="refresh" t-att-content="refresh"/>
                    </t>

                    <t t-set="page_icon" t-value="page_info_state if page_info_state in ('warn', 'ko', 'skipped', 'killed') else 'ok'"/>
                    <link rel="icon" type="image/png" t-attf-href="/runbot/static/src/img/icon_{{page_icon}}.png"/>
                    <link rel="icon" type="image/svg+xml" t-attf-href="/runbot/static/src/img/icon_{{page_icon}}.svg"/>
                </head>
                <body>
                    <t t-out="0"/>
                </body>
            </html>
        </template>

        <template id="runbot.layout" inherit_id="runbot.base_page" primary="True">
            <xpath expr="//body" position="replace">
                <body>
                    <header>
                        <nav class="navbar navbar-expand-md bg-body-tertiary">
                            <t t-set="projects" t-value="env['runbot.project'].search([('hidden', '=', False)])"/>
                            <a t-if="project" t-attf-href="/runbot/{{slug(project)}}?{{keep_query('*', search=None)}}">
                                <b class="active_project">
                                    <t t-out="project.name"/>
                                </b>
                            </a>
                            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#top_menu_collapse">
                                <span class="navbar-toggler-icon"/>
                            </button>
                            <div class="collapse navbar-collapse" id="top_menu_collapse">
                                <ul class="nav navbar-nav ms-auto text-end" id="top_menu">
                                    <t t-foreach="projects" t-as="l_project">
                                        <li class="nav-item">
                                            <a class="nav-link" t-attf-href="/runbot/{{slug(l_project)}}?{{keep_query('*', search=search)}}">
                                                <t t-out="l_project.name"/>
                                            </a>
                                        </li>
                                    </t>
                                    <li class="nav-item">
                                        <button command="show-modal" commandfor="collapsePreference" type="button" class="nav-link">
                                            <i class="fa fa-gear"/>
                                        </button>
                                    </li>
                                    <t t-if="not user_id._is_public()">
                                        <t t-if="env.user.has_group('runbot.group_runbot_admin')">
                                            <t t-set="docker_files" t-value="env['runbot.dockerfile'].search([])"/>
                                            <t t-set="out_of_sync_docker_files" t-value="docker_files.filtered(lambda d: d.image_identifier != d.image_future_identifier)"/>
                                            <t t-set="in_error_docker_files" t-value="docker_files.filtered(lambda d: d.to_build and d.in_error)"/>
                                            <li class="nav-item" t-if="out_of_sync_docker_files or in_error_docker_files">
                                                <a class="nav-link" href="/odoo/docker">
                                                    <i class="fa fa-warning"/>
                                                    <t t-if="in_error_docker_files">
                                                        <span class="text-danger" t-esc="len(in_error_docker_files)" title="In error docker files"/>
                                                    </t>
                                                    <t t-if="out_of_sync_docker_files">
                                                        <span class="text-warning" t-esc="len(out_of_sync_docker_files)" title="Out of sync docker files"/>
                                                    </t>
                                                </a>
                                            </li>
                                        </t>
                                        <li t-if="project and project.next_freeze_tag_id" class="nav-item" title="Freeze">
                                            <a class="nav-link" t-attf-href="/runbot/{{slug(project)}}/bundle/tag/{{slug(project.next_freeze_tag_id)}}">
                                                <i class="fa fa-snowflake-o"/>
                                            </a>
                                        </li>
                                        <t t-call="runbot.build_errors_link"/>
                                        <li class="nav-item dropdown" t-ignore="true">
                                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                                <b>
                                                    <span t-out="user_id.name[:23] + '...' if user_id.name and len(user_id.name) &gt; 25 else user_id.name"/>
                                                </b>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-end js_usermenu" role="menu">
                                                <li><a class="dropdown-item" id="o_logout" role="menuitem" t-attf-href="/web/session/logout?redirect=/">Logout</a></li>
                                                <li><a class="dropdown-item" role="menuitem" t-attf-href="/odoo">Backend</a></li>
                                                <li><div t-if="user_id.runbot_team_ids" class="dropdown-divider"/></li>
                                                <li><div t-if="user_id.runbot_team_ids" class="dropdown-header">Teams</div></li>
                                                <li><a t-foreach="user_id.runbot_team_ids" t-as="team" class="dropdown-item" role="menuitem" t-attf-href="/runbot/teams/{{team.id}}">
                                                    <t t-out="team.name.capitalize()"/>
                                                </a></li>
                                            </ul>
                                        </li>
                                    </t>
                                    <t t-else="">
                                        <li class="nav-item dropdown" t-ignore="true">
                                            <b>
                                                <a class="nav-link" t-attf-href="/web/login?redirect={{request.httprequest.path}}">Login</a>
                                            </b>
                                        </li>
                                    </t>
                                </ul>
                                <t t-out="nav_form or ''">
                                </t>
                            </div>
                        </nav>
                    </header>
                    <nav t-if="page_nav" class="container-fluid py-1 mb-2 d-flex gap-2 align-items-center bg-body-tertiary border-top" aria-label="Page">
                        <t t-out="page_nav"/>
                    </nav>
                    <dialog id="collapsePreference" class="modal modal-xl">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <header class="modal-header">
                                    <h5 class="modal-title">Preferences</h5>
                                    <button type="button" class="btn-close" command="close" commandfor="collapsePreference"/>
                                </header>
                                <div class="modal-body">
                                    <div class="row">
                                        <user-preference class="col-12">
                                            <form class="form-check form-switch">
                                                <label for="more" class="form-check-label" >More info</label>
                                                <input class="form-check-input" type="checkbox" role="switch" id="more" name="more" value="1" t-att-checked="more"/>
                                            </form>
                                        </user-preference>
                                    </div>
                                    <div class="row">
                                        <div id="label_pref_theme" class="col-md-1">Theme</div>
                                        <user-preference class="col-md-11">
                                            <form class="text-nowrap btn-group btn-group-sm" role="group" aria-labelledby="label_pref_theme">
                                                <input type="radio" class="btn-check" autocomplete="off" name="theme" id="pref_theme_legacy"
                                                    value="legacy" t-att-checked="theme == 'legacy'"/>
                                                <label class="btn btn-outline-primary" for="pref_theme_legacy">Legacy</label>
                                                <input type="radio" class="btn-check" autocomplete="off" name="theme" id="pref_theme_dark"
                                                    value="dark" t-att-checked="theme == 'dark'"/>
                                                <label class="btn btn-outline-primary" for="pref_theme_dark">Dark</label>
                                                <input type="radio" class="btn-check" autocomplete="off" name="theme" id="pref_theme_light"
                                                    value="light" t-att-checked="theme == 'light'"/>
                                                <label class="btn btn-outline-primary" for="pref_theme_light">Light</label>
                                                <input type="radio" class="btn-check" autocomplete="off" name="theme" id="pref_theme_red404"
                                                    value="red404" t-att-checked="theme == 'red404'"/>
                                                <label class="btn btn-outline-primary" for="pref_theme_red404">Red404</label>
                                            </form>
                                        </user-preference>
                                    </div>

                                    <hr class="separator"/>
                                    <user-preference t-if="triggers" t-att-data-default="'-'.join(map(str, triggers.filtered(lambda t: not t.manual and not t.hide).ids))">
                                        <form id="triggers_preference">
                                            <t t-foreach="categories" t-as="category">
                                                <t t-set="category_triggers" t-value="triggers.filtered(lambda t: not t.manual and t.category_id == category)"/>
                                                <t t-if="category_triggers">
                                                    <h3 t-out="category.name"/>
                                                    <div class="row">
                                                        <t t-foreach="category_triggers" t-as="trigger">
                                                            <div class="col-md-3 text-nowrap">
                                                                <input type="checkbox" t-attf-name="trigger_display_{{project.id}}" t-att-value="trigger.id" t-attf-id="trigger_{{trigger.id}}" t-att-checked="not trigger.hide if trigger_display is None else trigger.id in trigger_display"/>
                                                                <label t-attf-for="trigger_{{trigger.id}}" t-out="trigger.name"/>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </t>
                                            </t>
                                        </form>
                                    </user-preference>
                                </div>
                                <footer class="modal-footer">
                                    <button type="button" class="btn btn-secondary" form="triggers_preference" value="default">Reset to default</button>
                                    <button type="button" class="btn btn-secondary" form="triggers_preference" value="all">All</button>
                                    <button type="button" class="btn btn-secondary" form="triggers_preference" value="none">None</button>
                                    <button type="submit" class="btn btn-primary" form="triggers_preference">Save</button>
                                </footer>
                            </div>
                        </div>
                    </dialog>
                    <t t-call="runbot.build_menu"/>
                    <t t-out="0"/>
                </body>
            </xpath>
        </template>

        <template id="runbot.category_selector">
            <div class="d-flex align-items-center gap-1">
                <span id="page_nav_category" class="small text-body-secondary">Category</span>
                <div class="text-nowrap btn-group btn-group-ssm" role="group" aria-labelledby="page_nav_category">
                    <a t-foreach="categories" t-as="category"
                       t-attf-class="btn btn-outline-secondary{{' active' if category.id == active_category_id else ''}}"
                       t-att-aria-current="'page' if category.id == active_category_id else None"
                       t-attf-href="?{{keep_query('*', category=category.id)}}" t-out="category.name"/>
                </div>
            </div>
        </template>

        <template id="runbot.build_errors_link">
            <t t-set="nb_assigned_errors" t-value="env['runbot.build.error'].sudo().search_count([('responsible', '=', user_id.id)])"/>
            <t t-set="nb_team_errors" t-value="env['runbot.build.error'].sudo().search_count([('responsible', '=', False), ('team_id', 'in', user_id.runbot_team_ids.ids)])"/>
            <t t-if="nb_assigned_errors">
                <li class="nav-item">
                    <a href="/runbot/errors" class="nav-link text-danger" t-attf-title="You have {{nb_assigned_errors}} random bug assigned">
                        <i class="fa fa-bug"/>
                        <t t-out="nb_assigned_errors"/>
                        <span class="text-warning" t-if="nb_team_errors">+<t t-out="nb_team_errors"/></span>
                    </a>
                </li>
            </t>
            <t t-elif="nb_team_errors">
                <li class="nav-item">
                    <a href="/runbot/errors" class="nav-link text-warning" t-attf-title="Your team has {{nb_team_errors}} random bug assigned">
                        <i class="fa fa-bug"/>
                        <t t-out="nb_team_errors"/>
                    </a>
                </li>
            </t>
            <t t-elif="env['runbot.build.error'].sudo().search_count([])">
                <li class="nav-item">
                    <a href="/runbot/errors" class="nav-link" title="Random Bugs"><i class="fa fa-bug"/></a>
                </li>
            </t>
        </template>

        <template id="runbot.slots_infos" name="Hosts slot nb pending/testing/slots">
            <a href="/runbot/load_info" class="slots_infos">
                <span t-attf-class="badge text-bg-{{pending_level}}">
                    Pending:
                    <t t-out="pending_count"/><span title="Assigned build (reserved host)" t-if="pending_assigned_count">(<t t-out="pending_assigned_count"/>)</span>
                </span>
                <t t-set="testing" t-value="hosts_data._total_testing()"/>
                <t t-set="workers" t-value="hosts_data._total_workers()"/>
                <t t-set="klass">success</t>
                <t t-if="not workers" t-set="klass">danger</t>
                <t t-else="">
                    <t t-if="int(testing)/workers > 0" t-set="klass">info</t>
                    <t t-if="int(testing)/workers > 0.75" t-set="klass">warning</t>
                    <t t-if="int(testing)/workers >= 1" t-set="klass">danger</t>
                </t>
                <span t-attf-class="badge text-bg-{{klass}}">
                    Testing:
                    <t t-out="testing"/>
                    /
                    <t t-out="workers"/>
                </span>
            </a>
        </template>

        <template id="runbot.slot_button">
            <t t-set="bu" t-value="slot.build_id"/>
            <t t-set="color" t-value="bu._get_color_class()"/>
            <div t-attf-class="btn-group btn-group-ssm slot_button_group {{'slot_link_created' if slot.link_type == 'created' else 'slot_link_matched'}}">
                <span t-attf-class="btn btn-{{color}} disabled">
                    <i t-if="slot.build_id.global_state in ('testing', 'pending', 'waiting')" class="fa fa-spinner fa-spin fa-fw"/>
                    <i t-else="" t-attf-class="fa fa-{{slot._fa_result()}} fa-fw"/>
                </span>
                <a t-if="slot.params_id.config_id == slot.trigger_id.light_config_id" class="badge btn btn-info" t-attf-href="/runbot/bundle/{{slot.batch_id.bundle_id.id}}">Light</a>
                <a t-if="bu" t-attf-href="/runbot/batch/{{slot.batch_id.id}}/build/#{bu.id}" t-attf-class="btn btn-default slot_name">
                    <!--i t-if="slot.link_type != 'created'" t-att-title="slot.link_type" t-attf-class="fa fa-{{slot._fa_link_type()}}"/-->
                    <span t-out="slot.trigger_id.name"/>
                </a>
                <span t-else="" t-attf-class="btn btn-default disabled slot_name">
                    <span t-out="slot.trigger_id.name"/>
                </span>
                <a t-if="slot.trigger_id.report_view_id" title="View last trigger report" t-attf-href="/runbot/trigger/report/{{slot.trigger_id.id}}" class="fa fa-eye btn btn-info"/>
                <a t-if="bu.local_state == 'running' and bu.database_ids" t-attf-href="/runbot/run/{{bu.id}}" class="fa fa-sign-in btn btn-info"/>
                <a t-if="bu.static_run" t-att-href="bu.static_run" class="fa fa-sign-in btn btn-info"/>
                <t t-if="bu" t-call="runbot.build_menu_button"/>
                <a t-if="not bu" groups="base.group_user" class="btn btn-default" title="Create build" t-attf-href="/runbot/batch/slot/{{slot.id}}/build">
                    <t t-set="required_triggers" t-value="slot.trigger_id.starts_after_ids"/>
                    <t t-if="required_triggers">
                        <t t-set="success_trigger" t-value="slot.batch_id.slot_ids.filtered(lambda s: s.build_id.global_state in ('running', 'done') and s.build_id.global_result == 'ok').trigger_id"/>
                        <t t-set="required_triggers" t-value="required_triggers - success_trigger"/>
                    </t>
                    <t t-if="required_triggers">
                        <i class="fa fa-hourglass fa-fw" t-attf-title="Waiting for trigger(s) {{', '.join(required_triggers.mapped('name'))}} (click to start anyway)"/>
                    </t>
                    <t t-else="">
                        <i class="fa fa-play fa-fw"/>
                    </t>
                </a>
            </div>
        </template>

        <template id="runbot.build_button">
            <div t-attf-class="float-end">
                <div t-attf-class="btn-group {{klass}}">
                    <a t-if="bu.local_state == 'running' and bu.database_ids" t-attf-href="/runbot/run/{{bu.id}}" class="btn btn-info" title="Sign in on this build" aria-label="Sign in on this build">
                        <i class="fa fa-sign-in"/>
                    </a>
                    <a t-if="bu.static_run" t-att-href="bu.static_run" class="btn btn-info" title="View result" aria-label="View result">
                        <i class="fa fa-sign-in"/>
                    </a>
                    <a groups="base.group_user" t-if="bu.local_state=='done' and (not bu.parent_id.database_ids or user_id.has_group('runbot.group_runbot_advanced_user')) and bu.requested_action != 'wake_up' and bu.database_ids" href="#" data-runbot="wakeup" t-att-data-runbot-build="bu.id" class="btn btn-default" title="Wake up this build" aria-label="Wake up this build">
                        <i class="fa fa-coffee"/>
                    </a>
                    <a t-attf-href="/runbot/build/{{bu['id']}}" class="btn btn-default" title="Build details" aria-label="Build details">
                        <i class="fa fa-file-text-o"/>
                    </a>
                    <!--<a t-if="show_commit_button" t-attf-href="https://#{repo.base_url}/commit/#{bu['name']}" class="btn btn-default" title="Open commit on GitHub" aria-label="Open commit on GitHub"><i class="fa fa-github"/></a>-->
                    <t t-call="runbot.build_menu_button"/>
                </div>
            </div>
        </template>
        <!-- Event / Logs page -->
        <template id="runbot.build_class">
            <t t-set="rowclass">info</t>
            <t t-if="build.global_state in ['running','done']">
                <t t-if="build.global_result == 'ok'">
                    <t t-set="rowclass">success</t>
                </t>
                <t t-if="build.global_result == 'skipped'">
                    <t t-set="rowclass">default</t>
                </t>
                <t t-if="build.global_result == 'killed'">
                    <t t-set="rowclass">killed</t>
                </t>
            </t>
            <t t-if="build.global_result == 'ko'">
                <t t-set="rowclass">danger</t>
            </t>
            <t t-if="build.global_result == 'warn'">
                <t t-set="rowclass">warning</t>
            </t>
            <t t-out="rowclass"/>
        </template>

        <template id="runbot.build_menu">
            <template id="build-options-dropdown-menu">
                <ul class="dropdown-menu dropdown-menu-end" role="menu">
                    <t groups="runbot.group_runbot_admin">
                        <li t-attf-t-if="global_result=='skipped'">
                            <button class="dropdown-item" type="button" data-runbot="rebuild" data-runbot-build="{{id}}">
                                <i class="fa fa-fw fa-level-up"/> Force Build
                            </button>
                        </li>
                    </t>
                    <li t-attf-t-if="local_state=='running'" t-attf-t-foreach="databases" t-attf-t-as="db_suffix">
                        <a class="dropdown-item" href="/runbot/run/{{id}}/{{db_suffix}}">
                            <i class="fa fa-fw fa-sign-in"/> Connect {{db_suffix}}
                        </a>
                    </li>
                    <li t-attf-t-if="local_state=='running'">
                        <a class="dropdown-item" href="http://{{domain}}/web/database/selector">
                            <i class="fa fa-fw fa-sign-in"/> Database selector
                        </a>
                    </li>
                    <t groups="base.group_user">
                        <li t-attf-t-if="global_state in ['done','running'] or to_kill">
                            <button type="button" class="dropdown-item" data-runbot="rebuild" data-runbot-build="{{id}}" title="Retry this build, usefull for false positive">
                                <i class="fa fa-fw fa-refresh"/> Rebuild
                            </button>
                        </li>
                        <li t-attf-t-if="global_state != 'done' and not to_kill">
                            <button type="button" class="dropdown-item" data-runbot="kill" data-runbot-build="{{id}}">
                                <i class="fa fa-fw fa-crosshairs"/> Kill
                            </button>
                        </li>
                        <li t-attf-t-if="global_state != 'done' and to_kill">
                            <span class="dropdown-item disabled">
                                <i class="fa fa-fw fa-crosshairs"/> Killing <i class="fa fa-spinner fa-spin"/>
                            </span>
                        </li>
                        <li t-attf-t-if="global_state == 'done' and requested_action != 'wake_up' and databases">
                            <button class="dropdown-item" type="button" data-runbot="wakeup" data-runbot-build="{{id}}">
                                <i class="fa fa-fw fa-coffee"/> Wake up
                            </button>
                        </li>
                        <li t-attf-t-if="global_state == 'done' and requested_action == 'wake_up'">
                            <span class="dropdown-item disabled">
                                <i class="fa fa-fw fa-coffee"/> Waking up <i class="fa fa-spinner fa-spin"/>
                            </span>
                        </li>
                    </t>
                    <li t-attf-t-if="host and log_list"><hr class="dropdown-divider"/></li>
                    <li t-attf-t-if="host" t-attf-t-foreach="log_list" t-attf-t-as="log_name">
                        <a class="dropdown-item" href="http://{{host}}/runbot/static/build/{{dest}}/logs/{{log_name}}.txt">
                            <i class="fa fa-fw fa-file-text-o"/> Full {{log_name}} logs
                        </a>
                    </li>
                    <t groups="runbot.group_runbot_advanced_user">
                        <li><hr class="dropdown-divider"/></li>
                        <li>
                            <a class="dropdown-item" href="/runbot/build/search?config_id={{config_id}}&amp;trigger_id={{trigger_id}}&amp;version_id={{version_id}}&amp;create_batch_id.bundle_id={{bundle_id}}&amp;description={{description}}">
                                <i class="fa fa-fw fa-search"/> Find similar builds
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/odoo/build/{{id}}">
                                <i class="fa fa-fw fa-list"/> View in backend
                            </a>
                        </li>
                    </t>
                </ul>
            </template>
        </template>

        <template id="runbot.build_menu_button">
            <build-options-dropdown t-attf-class="btn {{'btn-default' if bu.global_state not in ('waiting', 'pending', 'testing') else 'btn-info'}}" title="Build options" aria-label="Build options"
                t-att-data-id="bu.id"
                t-att-data-global_result="bu.global_result"
                t-att-data-global_state="bu.global_state"
                t-att-data-local_state="bu.local_state"
                t-att-data-databases="json.dumps([b.db_suffix for b in bu.database_ids.sorted('name')])"
                t-att-data-domain="bu.domain"
                t-att-data-to_kill="bu.to_kill or 'false'"
                t-att-data-requested_action="bu.requested_action or ''"
                t-att-data-dest="bu.dest"
                t-att-data-config_id="bu.config_id.id"
                t-att-data-trigger_id="bu.trigger_id.id or ''"
                t-att-data-version_id="bu.version_id.id or ''"
                t-att-data-bundle_id="bu.create_batch_id.bundle_id.id or ''"
                t-att-data-description="bu.description or ''"
                t-att-data-log_list="json.dumps(bu.log_list.split(',') if bu.log_list else [])"
                t-att-data-host="bu.host or ''"
            >
                <i t-attf-class="fa {{'fa-spinner' if bu.global_state == 'pending' else 'fa-cog'}} fa-fw"/>
            </build-options-dropdown>
        </template>

        <template id="runbot.branch_github_menu">
          <button t-attf-class="{{btn_classes or 'btn btn-default btn-ssm'}} dropdown-toggle" data-bs-toggle="dropdown" title="Github links" aria-label="Github links" aria-expanded="false">
            <i t-attf-class="fa fa-github {{'text-primary' if any(branch_id.is_pr and branch_id.alive for branch_id in bundle.branch_ids) else 'text-secondary' if all(not branch_id.alive for branch_id in bundle.branch_ids) else ''}}"/>
          </button>
          <ul class="dropdown-menu" role="menu">
            <li t-foreach="bundle.branch_ids.sorted(key=lambda b: (not b.alive, b.remote_id.repo_id.sequence, b.remote_id.repo_id.id, b.is_pr, b.id))" t-as="branch">
              <t t-set="link_title" t-value="'View %s %s on Github' % ('PR' if branch.is_pr else 'Branch', branch.name)"/>
              <a t-att-href="branch.branch_url" class="dropdown-item" t-att-title="link_title">
                <span class="fst-italic text-muted" t-out="branch.remote_id.short_name"/> <span t-att-class="'' if branch.alive else 'line-through'" t-out="branch.name"/> <i t-if="not branch.alive" title="deleted/closed" class="fa fa-ban text-danger"/>
              </a>
            </li>
          </ul>
        </template>

        <template id="runbot.branch_copy_button">
            <button type="button" t-attf-class="btn btn-default {{btn_size or 'btn-ssm'}}" title="Copy Bundle name" aria-label="Copy Bundle name" t-att-data-copy-text="bundle.name.split(':')[-1]">
              <i t-attf-class="fa fa-clipboard"/>
            </button>
        </template>

    </data>
</odoo>
