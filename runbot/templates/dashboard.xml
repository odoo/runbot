<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="runbot.glances">
      <t t-call="runbot.layout">
        <t t-set="head">
          <t t-if="refresh">
            <meta http-equiv="refresh" t-att-content="refresh"/>
          </t>
        </t>
        <div class="container-fluid">
          <div class="row">
            <div class='col-md-12'>
              <div>
                <span t-attf-class="badge text-bg-{{pending_level}}">
                  Pending:
                  <t t-out="pending_count"/><span title="Assigned build (reserved host)" t-if="pending_assigned_count">(<t t-out="pending_assigned_count"/>)</span>
                </span>
              </div>
              <t t-set="project_id"/>
              <t t-set="nb_project" t-value="len(bundles.mapped('project_id'))"/>
              <t t-foreach="bundles.sorted(lambda b: (-b.project_id.id, b.version_id.number), reverse=True)" t-as="bundle">
                <h3 t-if="nb_project > 1 and project_id != bundle.project_id.id" t-out="bundle.project_id.name"/>
                <t t-set="project_id" t-value="bundle.project_id.id"/>
                <h4>
                  <t t-out="bundle.name"/>
                </h4>
                <t t-foreach="bundle.last_done_batch.slot_ids" t-as="slot">
                  <span t-attf-class="badge text-bg-{{slot.build_id._get_color_class()}}">
                    <t t-out="slot.trigger_id.name"/>
                  </span>
                </t>
              </t>
            </div>
          </div>
        </div>
      </t>
    </template>

    <template id="frontend_no_nav" inherit_id="runbot.layout" primary="True">
      <xpath expr="//header" position="replace">
      </xpath>
    </template>

    <template id="runbot.config_monitoring">
      <t t-call="runbot.frontend_no_nav">
        <t t-set="head">
          <t t-if="refresh">
            <meta http-equiv="refresh" t-att-content="refresh"/>
          </t>
        </t>
      </t>
    </template>

    <template id="runbot.monitoring">
      <t t-call="runbot.frontend_no_nav">
        <t t-set="head">
          <t t-if="refresh">
            <meta http-equiv="refresh" t-att-content="refresh"/>
          </t>
          <style>
            h4 {
            padding: 3px 0;
            border-bottom: 1px solid grey;
            }
            .r-mb02 { margin-bottom: 0.2em; }
          </style>
        </t>
        <div class="container-fluid">
          <div class="row">
            <div class="col-md-12">
              <div>
                <t t-call="runbot.slots_infos"/>
              </div>
              <t t-foreach="hosts_data.sorted(key=lambda h:h.name)" t-as="host">
                <div>
                  <span t-out="host.name.split('.')[0]"/>
                  <t t-if="host.nb_testing == 0">
                    <t t-set="klass">success</t>
                  </t>
                  <t t-if="host.nb_testing > 0">
                    <t t-set="klass">info</t>
                  </t>
                  <t t-if="host.nb_testing == host.nb_worker">
                    <t t-set="klass">warning</t>
                  </t>
                  <t t-if="host.nb_testing > host.nb_worker">
                    <t t-set="klass">danger</t>
                  </t>
                  <a t-attf-class="badge text-bg-{{klass}}" t-attf-href="/runbot/load_info?host={{host.name}}">
                    <span t-out="host.nb_testing"/>
                    /
                    <span t-out="host.nb_worker"/>
                  </a>
                  <t t-out="host.nb_running"/>
                  <t t-set="succes_time" t-value="int(datetime.datetime.now().timestamp() - host.last_success.timestamp())"/>
                  <t t-set="start_time" t-value="int(datetime.datetime.now().timestamp() - host.last_start_loop.timestamp())"/>
                  <t t-set="end_time" t-value="int(datetime.datetime.now().timestamp() - host.last_end_loop.timestamp())"/>

                  <t t-set="klass">success</t>
                  <t t-if="succes_time > 30">
                    <t t-set="klass">info</t>
                  </t>
                  <t t-if="succes_time > 180">
                    <t t-set="klass">danger</t>
                  </t>

                  <span t-attf-class="badge text-bg-{{klass}}">
                    <span t-out="succes_time"/>
                  </span>

                  <t t-set="klass">success</t>
                  <t t-if="start_time > 60*10">
                    <t t-set="klass">info</t>
                  </t>
                  <t t-if="start_time > 60*15">
                    <t t-set="klass">danger</t>
                  </t>

                  <span t-attf-class="badge text-bg-{{klass}}">
                    <span t-out="start_time"/>
                  </span>

                  <t t-set="klass">success</t>
                  <t t-if="end_time > 60*10">
                    <t t-set="klass">info</t>
                  </t>
                  <t t-if="end_time > 60*15">
                    <t t-set="klass">danger</t>
                  </t>

                  <span t-attf-class="badge text-bg-{{klass}}">
                    <span t-out="end_time"/>
                  </span>

                  <t t-set="loop_time" t-value="end_time-start_time"/>
                  <t t-set="klass">success</t>
                  <t t-if="abs(loop_time) > 10">
                    <t t-set="klass">info</t>
                  </t>
                  <t t-if="abs(loop_time) > 60">
                    <t t-set="klass">danger</t>
                  </t>
                  <span t-attf-class="badge text-bg-{{klass}}">
                    <span t-out="loop_time"/>
                  </span>

                </div>
              </t>

              <table>
                <tr t-foreach="bundles.sorted(lambda b: b.version_id.number, reverse=True)" t-as="bundle">
                  <td>
                    <t t-out="bundle.version_id.number"/>
                  </td>
                  <td>
                    <t t-set='batch' t-value="bundle.with_context({'category_id': category.id}).last_done_batch"/>
                    <table>
                      <t t-foreach="batch.slot_ids" t-as='slot'>
                        <tr>
                          <td>
                            <t t-out="slot.trigger_id.name[:4]"/>
                          </td>
                          <t t-set="build" t-value="slot.build_id"/>
                          <td>
                            <span t-attf-class="badge text-bg-{{slot.build_id._get_color_class()}}">
                              <i t-attf-class="fa fa-{{category.icon}}"/>
                            </span>
                          </td>
                        </tr>
                      </t>
                    </table>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </t>
    </template>

    <template id="runbot.default_dashboard_tile_view">
      <div class="col-md-3 col-lg-2 p-2">
        <div class="card">
          <div class="card-header" data-toggle="limited-height" t-attf-data-target="#tile_{{tile.id}}">
            <t t-out="tile.display_name"/> <t t-if="tile.build_ids"> (<t t-out="len(tile.build_ids)"/>)</t>
          </div>
          <div class="card-body limited-height" t-attf-id="tile_{{tile.id}}">
            <p t-if="not tile.build_ids" class="text-success my-0">No build found 👍</p>
            <t t-foreach="tile.sticky_bundle_ids.sorted(lambda b: b.version_id.number, reverse=True)" t-as="bundle">
              <t t-set="failed_builds" t-value="tile.build_ids.filtered(lambda b: b.top_parent.slot_ids.batch_id.bundle_id == bundle)"/>
              <h4 class="card-title" t-if="failed_builds" t-out="bundle.name"/>
              <p t-foreach="failed_builds" t-as="build" class="my-0">
                  <a class="text-danger" t-attf-href="/runbot/build/{{build.id}}" target="_blank">
                    <t t-out="build.description or build.id"/>
                  </a>
              </p>
            </t>
            <hr/>
          </div>
        </div>
      </div>
    </template>

    <template id="runbot.dashboard">
      <div class="row">
        <t t-foreach="dashboard.dashboard_tile_ids" t-as="tile">
          <t t-if="tile.build_ids or not hide_empty" t-call="{{ tile.custom_template_id.id }}"/>
        </t>
      </div>
    </template>

    <template id="runbot.dashboard_page">
      <t t-call="runbot.frontend_no_nav">
        <t t-set="head">
          <t t-if="refresh">
            <meta http-equiv="refresh" t-att-content="refresh"/>
          </t>
        </t>
        <t t-call="runbot.dashboard"/>
      </t>
    </template>

    <template id="runbot.load_info">
       <t t-call="runbot.layout">
        <div class="container-fluid frontend">
          <div class="row">
            <div class="col-md-12">
                <t t-call="runbot.slots_infos"/>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm">
              <t t-foreach="build_by_bundle" t-as="bundle_builds">
                <t t-set="bundle" t-value="bundle_builds[0]"/>
                <t t-set="builds" t-value="bundle_builds[1]"/>

                <tr class="bundle_row">
                  <td colspan="6">
                    <i t-if="bundle.sticky" class="fa fa-star" style="color: #f0ad4e"/>
                    <a t-attf-href="/runbot/bundle/#{bundle.id}" title="View Bundle">
                      <b t-out="bundle.name"/>
                    </a>
                    <span class="badge text-bg-info" t-out="len(builds)"/>
                  </td>
                </tr>
                <t t-foreach="builds" t-as="build">
                  <t t-set="rowclass" t-value="build._get_color_class()"/>
                  <tr t-attf-class="bg-{{rowclass}}-subtle {{'line-through' if build.orphan_result else ''}}">
                    <td>
                        <t t-set="batch" t-value="build.params_id.create_batch_id"/>
                        Batch: <a t-attf-href="/runbot/batch/{{batch.id}}"><t t-out="batch.id"/></a>
                        <span t-if="batch.priority_level &lt; int(batch.create_date.timestamp())" class="badge text-bg-warning">high priority</span>
                        <span t-if="batch.priority_level &gt; int(batch.create_date.timestamp())" class="badge text-bg-info">low priority</span>
                        </td>
                    <td><a t-attf-href="/runbot/build/{{build.id}}"><t t-out="build.parent_path"/></a></td>
                    <td>
                        <span t-attf-class="badge text-bg-{{'secondary' if build.local_state == 'pending' else 'info'}}" t-out="build.local_state"/>
                        <span t-if="build.build_type=='scheduled'" class="badge text-bg-danger">scheduled</span>
                        <span t-if="build.build_type=='priority'" class="badge text-bg-warning">priority</span>
                    </td>
                    <td><t t-out="build.active_step.name"/></td>
                    <td><t t-out="build.host"/></td>
                    <td><t t-out="build.config_id.name"/></td>
                    <td><span title="build_time" t-out="s2human(build.build_time)"/></td>
                    <td><span title="wait_time" t-out="s2human(build.wait_time-build.build_time)"/></td>
                  </tr>
                </t>
              </t>
            </table>
          </div>
        </div>
      </t>
    </template>

    <template id="runbot.queue">
      <t t-call="runbot.layout">
        <div class="container-fluid frontend">
          <div class="row">
            <div class="col-md-12">
                <t t-call="runbot.slots_infos"/>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm">
              <t t-foreach="queue" t-as="queue_item">
                <t t-set="build" t-value="queue_item[0]"/>
                <t t-set="tag" t-value="queue_item[1]"/>
                <t t-set="batch" t-value="build.params_id.create_batch_id"/>
                <tr>
                  <td t-out="queue_item_index + 1"/>
                  <td>
                    <span t-if="tag == 'waiting'" class="badge text-bg-info">waiting</span>
                    <span t-elif="tag == 'priority'" class="badge text-bg-warning">extra slot</span>
                    <span t-elif="tag == 'scheduled'" class="badge text-bg-danger">scheduled</span>
                    <span t-else="" class="badge text-bg-success">normal</span>
                  </td>
                  <td t-out="s2human(time.time() - max(build.create_date, build.params_id.reference_build_id.build_end or build.create_date).timestamp())"/>
                  <td t-out="build.priority_level"/>
                  <td>
                      <a t-attf-href="/runbot/batch/{{batch.id}}"><t t-out="batch.bundle_id.name"/></a>
                  </td>
                  <td>
                    <span t-if="batch.priority_level &lt; int(batch.create_date.timestamp())" class="badge text-bg-warning">high priority</span>
                    <span t-if="batch.priority_level &gt; int(batch.create_date.timestamp())" class="badge text-bg-info">low priority</span>
                  </td>
                  <td><a t-attf-href="/runbot/build/{{build.id}}"><t t-out="build.parent_path"/></a></td>
                  <td><t t-out="build.config_id.name"/></td>
                </tr>
              </t>
            </table>
          </div>
        </div>
      </t>
    </template>
  </data>
</odoo>
