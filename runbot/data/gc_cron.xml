<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_gc_commit_link_diff" model="ir.cron">
        <field name="name">GC Commit Link Diffs</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_runbot_commit_link"/>
        <field name="state">code</field>
        <field name="code">model._gc_diff(delta_days=1)</field>
    </record>

    <record id="ir_cron_gc_logs" model="ir.cron">
        <field name="name">GC Logs</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="base.model_ir_logging"/>
        <field name="state">code</field>
        <field name="code">model._gc_ir_logging()</field>
    </record>

    <record id="ir_cron_gc_stats" model="ir.cron">
        <field name="name">GC Stats</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_runbot_build_stat"/>
        <field name="state">code</field>
        <field name="code">model._gc_stats()</field>
    </record>
</odoo>
