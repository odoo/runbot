<odoo>
  <data>

    <record id="host_form" model="ir.ui.view">
        <field name="name">runbot.host.form</field>
        <field name="model">runbot.host</field>
        <field name="arch" type="xml">
            <form string="Host">
                <sheet>
                    <group>
                        <field name="name" readonly='1'/>
                        <field name="disp_name"/>
                        <field name="active"/>
                        <field name="use_remote_docker_registry"/>
                        <field name="is_leader"/>
                        <field name="is_assigner"/>
                        <field name="send_status" invisible="not is_leader"/>
                        <field name="is_builder"/>
                        <field name="is_registry"/>
                        <field name="is_backup"/>
                        <field name="docker_registry_url"/>
                        <field name="last_start_loop" readonly='1' options="{'numeric': true}"/>
                        <field name="last_end_loop" readonly='1' options="{'numeric': true}"/>
                        <field name="last_success" readonly='1' options="{'numeric': true}"/>
                        <field name="assigned_only"/>
                        <field name="nb_worker"/>
                        <field name="nb_run_slot"/>
                        <field name="last_exception" readonly='1'/>
                        <field name="exception_count" readonly='1'/>
                        <field name="profile"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="host_message_ids" readonly='1'/>
                        </page>
                        <page string="Builds">
                            <field name="build_ids" widget="many2many" options="{'not_delete': True, 'no_create_edit': True}" readonly='1'>
                                <list string="Builds">
                                    <field name="create_date" options="{'numeric': true}"/>
                                    <field name="global_state"/>
                                    <field name="global_result"/>
                                    <field name="job"/>
                                    <field name="dest" widget="char_frontend_url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_host_tree" model="ir.ui.view">
        <field name="name">runbot.host.list</field>
        <field name="model">runbot.host</field>
        <field name="arch" type="xml">
            <list string="Hosts"
                  default_order="is_leader desc, is_registry desc, is_backup desc, assigned_only desc, paused desc, disp_name, id"
                  decoration-warning="assigned_only and (not is_leader and not paused)"
                  decoration-success="is_leader"
                  decoration-muted="paused">
                <field name="name"/>
                <field name="disp_name" optional="hide"/>
                <field name="assigned_only" widget="boolean_toggle" string="Reserved"/>
                <field name="use_remote_docker_registry" widget="boolean_toggle" string="Use Docker Registry"/>
                <field name="nb_worker" string="# Testing"/>
                <field name="nb_run_slot" string="# Running"/>
                <field name="is_leader" string="Leader"/>
                <field name="is_assigner" string="Assigner"/>
                <field name="is_builder" string="Builder"/>
                <field name="is_registry" string="Registry"/>
                <field name="is_backup" string="Backup"/>
                <field name="paused" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="open_view_host_tree" model="ir.actions.act_window">
        <field name="name">Host</field>
        <field name="res_model">runbot.host</field>
        <field name="view_mode">list,form</field>
        <field name="path">host</field>
    </record>

    <record model="ir.actions.server" id="action_pause_hosts">
        <field name="name">Pause Selected Hosts</field>
        <field name="model_id" ref="runbot.model_runbot_host" />
        <field name="binding_model_id" ref="runbot.model_runbot_host" />
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="code">
            action = records._action_pause()
        </field>
    </record>

    <record model="ir.actions.server" id="action_unpause_hosts">
        <field name="name">Unpause Selected Hosts</field>
        <field name="model_id" ref="runbot.model_runbot_host" />
        <field name="binding_model_id" ref="runbot.model_runbot_host" />
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="code">
            action = records._action_unpause()
        </field>
    </record>

  </data>
</odoo>
