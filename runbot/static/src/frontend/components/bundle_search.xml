<?xml version="1.0" encoding="UTF-8"?>
<templates>
  <t t-name="runbot.BundleSearch">
    <form class="form-inline my-2 my-lg-0" role="search" method="get" t-on-submit.prevent="(ev) => this.submitSearch(ev)">
      <div class="input-group md-form form-sm form-2 ps-0">
        <input class="form-control my-0 py-1" type="text" placeholder="Search" aria-label="Search" name="search" t-model="searchState.search"/>
        <input type="checkbox" class="d-none" name="has_pr" id="has_pr" t-model="searchState.has_pr"/>
        <label class="btn btn-outline-primary input-group-text o_runbot_hidden_checkbox" t-att-class="{active: searchState.has_pr}" title="Toggle PR State" for="has_pr" tabindex="0"
          t-on-keydown="(ev) => this.onHasPrKeydown(ev)">
          <i class="fa fa-github text-grey"/>
        </label>
        <button type='submit' class="input-group-text">
          <i class="fa fa-search text-grey"/>
        </button>
      </div>
    </form>
  </t>
</templates>
